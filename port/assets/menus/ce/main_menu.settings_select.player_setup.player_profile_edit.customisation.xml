		<string text="Your legs in first person, seen looking down,\nmoving as you run. Your body as others see it."/>
		<string text="Shields light their surroundings as they flare.\nOnline: the host's choice."/>
		<string text="Toggle between classic and modern vehicle and\nweapon textures."/>
		<string text="Choose what intro video plays on launch."/>
		<string text="Choose what version of the credits play in the\nmain menu."/>
		<string text="The energy shield's flare on your first-person\narms too, as on your body."/>
		<string text="The overshield rises up the body and stays lit,\nin its own color. Online: the host's choice."/>
		<string text="The gameplay button pictures."/>
		<string text="Original: black/white buttons. Modern: LB/RB."/>
